rules_version = '2';

// Copia de las reglas publicadas en la consola de Firebase → Firestore → Reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    // Coach de este alumno: el alumno creó coachLinks/{uid} con el código de ese coach
    function isCoachOf(uid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/coachLinks/$(uid))
        && get(/databases/$(database)/documents/coachLinks/$(uid)).data.coachUid == request.auth.uid;
    }

    // Cada usuario lee y escribe sus propios datos. Su coach (si tiene) solo puede leerlos.
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || isCoachOf(uid));
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Rutinas y dietas compartidas: quien tenga sesión puede abrir una si conoce el código
    // (no se pueden listar). Solo el dueño la crea o la borra; no se puede sobrescribir.
    match /shared/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerName', 'routine', 'diet', 'program', 'createdAt']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Código de gymbro: quien lo conoce puede leerlo para agregarte. Solo el dueño lo crea o lo borra.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerName', 'createdAt']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Perfil (récords, estadísticas, últimos entrenamientos): lo escribe el dueño y solo sus gymbros lo leen
    match /profiles/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid
        || exists(/databases/$(database)/documents/chats/$(uid + '_' + request.auth.uid))
        || exists(/databases/$(database)/documents/chats/$(request.auth.uid + '_' + uid)));
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'stats', 'prs', 'recent', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Código de coach: quien lo conoce puede leerlo para vincularse. Solo el dueño lo crea o lo borra.
    match /coachCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerName', 'createdAt']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Vínculo alumno → coach. Lo crea el alumno con el código del coach; el alumno actualiza su resumen;
    // cualquiera de los dos lo termina. El coach ve la lista de sus alumnos.
    match /coachLinks/{studentUid} {
      allow get: if request.auth != null && (request.auth.uid == studentUid || resource.data.coachUid == request.auth.uid);
      allow list: if request.auth != null && resource.data.coachUid == request.auth.uid;
      allow create: if request.auth != null && request.auth.uid == studentUid
        && request.resource.data.keys().hasOnly(['studentUid', 'studentName', 'coachUid', 'coachName', 'via', 'since', 'summary'])
        && request.resource.data.studentUid == studentUid
        && request.resource.data.coachUid != studentUid
        && exists(/databases/$(database)/documents/coachCodes/$(request.resource.data.via))
        && get(/databases/$(database)/documents/coachCodes/$(request.resource.data.via)).data.ownerUid == request.resource.data.coachUid;
      allow update: if request.auth != null && request.auth.uid == studentUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentName', 'summary']);
      allow delete: if request.auth != null && (request.auth.uid == studentUid || resource.data.coachUid == request.auth.uid);

      // Rutinas, programas y programa activo que el coach cambió: los escribe el coach y la app del alumno los aplica y los borra
      match /edits/{rid} {
        allow read: if request.auth != null && (request.auth.uid == studentUid || isCoachOf(studentUid));
        allow create, update: if isCoachOf(studentUid)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.keys().hasOnly(['routine', 'program', 'plan', 'deleted', 'kind', 'at', 'by']);
        allow delete: if request.auth != null && (request.auth.uid == studentUid || isCoachOf(studentUid));
      }
    }

    // Chats 1 a 1: solo los dos gymbros los ven. Se crean usando el código de gymbro (o de coach) del otro.
    function isMember(chatId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    match /chats/{chatId} {
      allow get: if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['members', 'names', 'via', 'last', 'createdAt'])
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && (
          (exists(/databases/$(database)/documents/invites/$(request.resource.data.via))
            && get(/databases/$(database)/documents/invites/$(request.resource.data.via)).data.ownerUid in request.resource.data.members
            && get(/databases/$(database)/documents/invites/$(request.resource.data.via)).data.ownerUid != request.auth.uid)
          || (exists(/databases/$(database)/documents/coachCodes/$(request.resource.data.via))
            && get(/databases/$(database)/documents/coachCodes/$(request.resource.data.via)).data.ownerUid in request.resource.data.members
            && get(/databases/$(database)/documents/coachCodes/$(request.resource.data.via)).data.ownerUid != request.auth.uid)
        );
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'names']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;

      match /messages/{msgId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.type in ['text', 'diet', 'routine', 'workout', 'pr', 'program']
          && request.resource.data.keys().hasOnly(['from', 'at', 'type', 'text', 'diet', 'routine', 'program'])
          && (!('text' in request.resource.data) || request.resource.data.text.size() <= 4000);
        // Cada uno puede editar (solo el texto) y borrar sus propios mensajes; el cambio se ve para los dos
        allow update: if isMember(chatId) && resource.data.from == request.auth.uid
          && resource.data.type == 'text'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000
          && request.resource.data.edited == true;
        allow delete: if isMember(chatId) && resource.data.from == request.auth.uid;
      }
    }
  }
}
