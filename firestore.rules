rules_version = '2';

// Copia de las reglas publicadas en la consola de Firebase → Firestore → Reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario solo puede leer y escribir sus propios datos
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Rutinas y dietas compartidas: quien tenga sesión puede abrir una si conoce el código
    // (no se pueden listar). Solo el dueño la crea o la borra; no se puede sobrescribir.
    match /shared/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerName', 'routine', 'diet', 'createdAt']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Código de gymbro: quien lo conoce puede leerlo para agregarte. Solo el dueño lo crea o lo borra.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerName', 'createdAt']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Chats 1 a 1: solo los dos gymbros los ven. Se crean usando el código de gymbro del otro.
    function isMember(chatId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    match /chats/{chatId} {
      allow get: if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['members', 'names', 'via', 'last', 'createdAt'])
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && get(/databases/$(database)/documents/invites/$(request.resource.data.via)).data.ownerUid in request.resource.data.members
        && get(/databases/$(database)/documents/invites/$(request.resource.data.via)).data.ownerUid != request.auth.uid;
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'names']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;

      match /messages/{msgId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.type in ['text', 'diet', 'routine', 'workout', 'pr']
          && request.resource.data.keys().hasOnly(['from', 'at', 'type', 'text', 'diet', 'routine'])
          && (!('text' in request.resource.data) || request.resource.data.text.size() <= 4000);
      }
    }
  }
}
